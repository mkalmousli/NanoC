// Build workflow, run by build.c via the bootstrap seed.
// ./builder [build|bootstrap|snapshot|docs|test|bench|clean|install|uninstall] [--prefix DIR] [--sanitize] [--no-editors]
A:=split(env("NC_ARGS"),"\n")
CC:=env("CC")
f has(x)
  r:=false
  for y A
    if y==x
      r=true
  r
f arg(k)
  r:=""
  for i range(len(A))
    if A[i]==k
      r=A[i+1]
  r
f ok(c)
  r:=sh(c)
  if r[0]!=0
    fail(c+"\n"+r[1]+r[2])
  r[1]
f files(c) = replace(ok(c),"\n"," ")
f cc(out,srcs,inc)
  san:=""
  if has("--sanitize")
    san=" -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -fno-pie -no-pie"
  else
    san=" -O2"
  ok(CC+" -std=c11 -D_POSIX_C_SOURCE=200809L -Wall -Wextra -Wpedantic -Werror "+inc+""+san+" "+srcs+" -o "+out)
f cfiles(dir) = files("find "+dir+" -name '*.c' | sort")
f modules() = files("find src -name '*.nc' ! -name '*.*.nc' | sort")
f generate(compiler,stage)
  ok("rm -rf "+stage+"; for f in "+modules()+"; do mkdir -p "+stage+"/$(dirname $f); "+compiler+" $f -o "+stage+"/${f%.nc}.c || exit 1; done")
f same(x,y)
  ok("diff -r "+x+" "+y)
  log("Verified "+x+" == "+y)
f selfhost()
  cc("build/stage0",cfiles("bootstrap/src"),"-Ibootstrap/include")
  ok("rm -rf build/include; NC_BIN=build/stage0 NC_OUT=build/include build/nctool src/headers.tool.nc")
  generate("build/stage0","build/stage1")
  cc("build/stage1-nanoc",cfiles("build/stage1/src"),"-Ibuild/include")
  generate("build/stage1-nanoc","build/stage2")
  if env("NC_RESEED")==""
    same("build/stage1","build/stage2")
  cc("build/nanoc",cfiles("build/stage2/src"),"-Ibuild/include")
  generate("build/nanoc","build/stage3")
  same("build/stage2","build/stage3")
  log("Built self-hosted NanoC (C bootstrap -> NanoC -> NanoC)")
f san()
  r:="0"
  if has("--sanitize")
    r="1"
  r
f key() = ok("echo "+CC+" sanitize="+san()+"; find src bootstrap build.c -type f | sort | xargs cat | cksum")
f compile()
  ok("mkdir -p build")
  if read_or("build/config")==key() && exists("build/nanoc")
    log("Self-hosted NanoC is up to date")
  else
    selfhost()
    write("build/config",key())
f read_or(p)
  r:=""
  if exists(p)
    r=read(p)
  r
f lines()
  bad:=ok("find src tests examples build.c \\( -name '*.c' -o -name '*.h' -o -name '*.nc' -o -name '*.cpp' -o -name '*.hpp' \\) ! -name '*.*.nc' | xargs wc -l | awk '$1>200 && $2!=\"total\"'")
  if bad!=""
    fail("over 200 physical lines:\n"+bad)
f test(bench)
  lines()
  T:="build/tests-c"
  ok("rm -rf "+T+"; mkdir -p "+T)
  h:=ok("build/nanoc src/tests/test.h.nc")
  for t split(ok("find src/tests -name '*.test.nc' | sort"),"\n")
    if t!=""
      c:=T+"/"+replace(slice(t,find(t,"tests/")+6,len(t)),".test.nc",".c")
      ok("mkdir -p $(dirname "+c+"); build/nanoc "+t+" -o "+c)
      if !contains(t,"/main.") && !contains(t,"corpus_driver")
        h+=ok("build/nanoc --prototypes "+t)
  write(T+"/test.h","#ifndef NC_TEST_H\n#define NC_TEST_H\n"+h+"#endif\n")
  srcs:=replace(ok("find build/stage2/src "+T+" -name '*.c' ! -name main.c ! -name corpus_driver.c | sort")+" "+T+"/main.c","\n"," ")
  cc("build/tests",srcs,"-Ibuild/include -I"+T)
  r:=sh("ASAN_OPTIONS=${ASAN_OPTIONS}:detect_leaks=0 build/tests "+bench)
  log(r[1]+r[2])
  if r[0]!=0
    fail("tests failed")
f snapshot()
  ok("rm -rf bootstrap/src bootstrap/include build/config; mkdir -p bootstrap; cp -r build/include bootstrap/include")
  ok("cd build/stage3 && for f in $(find src -name '*.c'); do mkdir -p ../../bootstrap/$(dirname $f); { echo '/* Generated by ./builder snapshot; edit NanoC sources instead. */'; cat $f; } > ../../bootstrap/$f; done")
  ok("cd bootstrap && find src -name '*.c' | sort > sources.txt")
  ok("mkdir -p bootstrap/tools; for f in src/tools/*.tool.nc; do build/nanoc $f -o bootstrap/tools/$(basename ${f%.tool.nc}).c || exit 1; done")
  log("Refreshed readable C bootstrap and external tool runner")
f P(prefix) = "P='"+replace(prefix,"'","'\\''")+"'; "
f install(prefix)
  S:="build/install-stage/"
  n:=S+"share/nanoc/"
  ok("build/nctool src/editors.tool.nc")
  ok("rm -rf build/install-stage; mkdir -p "+S+"bin "+n+"docs "+n+"tools "+n+"examples; cp build/nanoc "+S+"bin/; cp README.md "+n+"; cp tools/*.py "+n+"tools/; cp docs/*.md "+n+"docs/; cp examples/*.nc "+n+"examples/; cp -r build/editors "+n+"; cp assets/icon.png "+n+"editors/vscode/icon.png")
  ok(P(prefix)+"M=\"$P/share/nanoc/install.manifest\"; cd build/install-stage && for f in $(find . -type f | sed 's|^./||'); do if [ -e \"$P/$f\" ] && ! grep -qxF \"$f\" \"$M\" 2>/dev/null; then echo \"refusing to overwrite unmanaged file: $f\" >&2; exit 1; fi; done; mkdir -p \"$P\" && cp -r . \"$P/\" && find . -type f | sed 's|^./||' | sort > \"$M\"; echo share/nanoc/install.manifest >> \"$M\"")
  log("Installed NanoC to "+prefix)
  if !has("--no-editors")
    log(ok(P(prefix)+"\"$P/bin/nanoc\" editor install || echo '! some editors could not be configured'"))
  log("Add to PATH: export PATH=\""+prefix+"/bin:$PATH\"")
f uninstall(prefix)
  ok(P(prefix)+"M=\"$P/share/nanoc/install.manifest\"; [ -f \"$M\" ] || { echo \"No NanoC installation at $P\"; exit 0; }; if grep -qE '(^|/)\\.\\.(/|$)|^/' \"$M\"; then echo 'invalid install manifest entry' >&2; exit 1; fi; (cd \"$P\" && xargs -d '\\n' rm -f < share/nanoc/install.manifest)")
  log("Removed recorded NanoC files from "+prefix)
act:="build"
for x ["build","bootstrap","snapshot","docs","test","bench","studio","clean","install","uninstall"]
  if has(x)
    act=x
prefix:=arg("--prefix")
if prefix==""
  prefix=env("HOME")+"/.local"
if act=="clean"
  ok("rm -rf build")
elif act=="uninstall"
  uninstall(prefix)
else
  if act=="bootstrap" || act=="snapshot"
    ok("rm -f build/config")
  compile()
  if act=="studio"
    ok("build/nctool src/studio/build.tool.nc")
  elif act=="docs"
    ok("build/nctool src/docs.tool.nc")
  elif act=="snapshot"
    snapshot()
    lines()
  elif act=="install"
    install(prefix)
  elif act=="test" || act=="bench"
    b:=""
    if act=="bench"
      b="--bench"
    test(b)
