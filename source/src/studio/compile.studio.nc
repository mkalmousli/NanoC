// Explicit compiler operations, expansion navigation and exportable review artifacts.
@lang 1
+ "studio.h"
// Expands a snapshot on request; compiler TT has no command or write builtins.
f st_expand(StApp *a)
  StFile *f=&a->files[a->active]
  st_cache(f)
  if a->generated
    free(a->previous)
    a->previous=st_copy(a->generated,strlen(a->generated))
  if a->compiler
    nc_dispose(a->compiler)
    free(a->compiler)
  a->compiler=calloc(1,sizeof *a->compiler)
  if !a->compiler
    exit(1)
  NcContext *c=a->compiler
  nc_init(c,f->path)
  c->tracing=true
  a->generated=NULL
  a->selected_event=0
  if setjmp(c->trap)
    a->message=c->error
    <
  a->generated=nc_transpile(c,f->text)
  a->message="Expanded; click either source view to inspect compiler provenance"
// Formats through the same lexical API as the CLI, recording an undoable replacement.
f st_format(StApp *a)
  StFile *f=&a->files[a->active]
  st_cache(f)
  NcContext *c=calloc(1,sizeof *c)
  if !c
    exit(1)
  nc_init(c,f->path)
  if !setjmp(c->trap)
    char *text=nc_format_source(c,f->text)
    if strcmp(text,f->text)
      st_edit(&f->buffer,0,strlen(f->text),text,strlen(text))
    a->message="Formatted"
  else
    a->message="Formatting failed; use Expand to inspect diagnostics"
  nc_dispose(c)
  free(c)
// Selects the deepest matching original-source operation or generated byte range.
f st_select_event(StApp *a,size_t offset,bool generated)
  if !a->compiler || !a->generated
    <
  StFile *f=&a->files[a->active]
  size_t line=st_line(f,offset)+1
  size_t best=SIZE_MAX
  for size_t i=0; i<a->compiler->traces.n; ++i
    NcTrace *e=&a->compiler->traces.v[i]
    bool match=generated ? e->start!=SIZE_MAX && offset>=e->start && offset<e->end : !e->synthetic && line>=(size_t)e->source.line && line<=(size_t)e->source.end_line
    size_t width=generated ? e->end-e->start : (size_t)(e->source.end_line-e->source.line)
    if match && width<=best
      best=width
      a->selected_event=(int)i+1
  if a->selected_event
    NcTrace *e=&a->compiler->traces.v[a->selected_event-1]
    if generated && !e->synthetic
      f->scroll=e->source.line>5 ? e->source.line-5 : 0
    elif !generated && e->start!=SIZE_MAX
      int n=0
      for size_t i=0; i<e->start; ++i
        if a->generated[i]=='\n'
          ++n
      a->c_scroll=n>5 ? n-5 : 0
// Exports the exact compiler map and source snapshots for external review tools.
f st_export(StApp *a)
  if !a->compiler || !a->generated
    a->message="Expand before exporting"
    <
  NcContext *c=a->compiler
  if setjmp(c->trap)
    a->message=c->error
    <
  nc_write(c,"nanoc-review.map.json",nc_trace_text(c,a->generated))
  nc_write(c,"nanoc-review.c",a->generated)
  nc_write(c,"nanoc-review.nc",a->files[a->active].text)
  a->message="Exported nanoc-review.nc, .c and .map.json"
// Follows one parent link in the expansion tree, preserving nested capture navigation.
f st_parent(StApp *a)
  if a->compiler && a->selected_event
    a->selected_event=(int)a->compiler->traces.v[a->selected_event-1].parent
