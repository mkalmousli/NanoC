{
  "NanoC function": {
    "prefix": "@f",
    "body": ["@f ${1:name}(${2:args}) ${3:int}", "  ${0:return}"],
    "description": "Function with a bare return type"
  },
  "NanoC macro": {
    "prefix": "@m",
    "body": ["@m ${1:name}(\\$${2:x})", "  ${0:body}"],
    "description": "Token-template macro"
  },
  "NanoC compile-time": {
    "prefix": "@ct",
    "body": ["@ct ${1:name}(${2:args})", "  ${0:emit(quote(\"\"))}"],
    "description": "Compile-time generator"
  },
  "NanoC build-time": {
    "prefix": "@bt",
    "body": ["@bt ${1:name}()", "  ${0:run([\"cc\", \"--version\"])}"],
    "description": "Build-time step (file and command access)"
  },
  "NanoC inline assembly": {
    "prefix": "@asm",
    "body": ["@asm", "  ${0:instruction}"],
    "description": "Inline assembly block"
  },
  "NanoC main": {
    "prefix": "main",
    "body": ["@f main int", "  ${0:0}"],
    "description": "Program entry point"
  }
}
