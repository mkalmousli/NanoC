{
  "name": "nanoc-language",
  "displayName": "NanoC",
  "description": "NanoC language support: syntax highlighting, snippets and file icons for the self-hosted NanoC compiler (less syntax, full control).",
  "version": "0.2.0",
  "publisher": "mkalmousli",
  "icon": "icon.png",
  "galleryBanner": {"color": "#11110f", "theme": "dark"},
  "categories": ["Programming Languages", "Snippets"],
  "keywords": ["nanoc", "c", "transpiler", "macros", "compile-time", "syntax"],
  "homepage": "https://mkalmousli.github.io/NanoC/",
  "repository": {"type": "git", "url": "https://github.com/mkalmousli/NanoC"},
  "bugs": {"url": "https://github.com/mkalmousli/NanoC/issues"},
  "engines": {"vscode": ">=1.75.0"},
  "contributes": {
    "languages": [{
      "id": "nanoc",
      "aliases": ["NanoC", "nanoc"],
      "extensions": [".nc"],
      "configuration": "./language-configuration.json",
      "icon": {"light": "./icons/nanoc.svg", "dark": "./icons/nanoc.svg"}
    }],
    "grammars": [{"language": "nanoc", "scopeName": "source.nanoc", "path": "./syntaxes/nanoc.tmLanguage.json", "embeddedLanguages": {"source.c": "c"}}],
    "snippets": [{"language": "nanoc", "path": "./snippets/nanoc.code-snippets"}]
  }
}
