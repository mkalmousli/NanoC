# NanoC syntax for GNU nano. Install with: nanoc editor install nano
syntax "nanoc" "\.nc$"
color brightmagenta "@(f|fn|m|macro|ct|bt|asm)\b"
color brightcyan "@[A-Za-z_][A-Za-z0-9_]*"
color brightyellow "\$\$?[A-Za-z_][A-Za-z0-9_]*(:[A-Za-z_]+|\.\.\.)?"
color magenta "\b(if|elif|else|for|while|break|continue|return|goto)\b"
color blue "\b(emit|quote|ident|fresh|rewrite|again|source|eval|assert|fail)\b"
color green "\b(void|bool|char|short|int|long|float|double|signed|unsigned|auto|const|volatile|static|struct|union|enum|typedef|size_t)\b"
color red "\b(true|false|NULL|nullptr)\b"
color yellow "\b[0-9]+(\.[0-9]+)?\b"
color yellow "\"([^\"\\]|\\.)*\""
color yellow "'([^'\\]|\\.)'"
color brightblack "//.*"
color brightblack start="/\*" end="\*/"
