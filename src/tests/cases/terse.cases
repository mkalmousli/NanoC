suite final v1 compact declarations, C operators and word controls
case explicit functions and parameters
  nanoc
    f set(int *p) -> static void
      *p=42
    f add(a: int, b: int) -> int = a+b
    f main() -> int
      n:=0
      for ;;
        set(&n)
        break
      return add(n,1)!=43
case nested conditions
  nanoc
    f sign(n: int) -> int
      if n>0
        return 1
      elif n<0
        return -1
      else
        return 0
    f main() -> int = sign(-3)!=-1 || sign(0)!=0 || sign(5)!=1
case pointers, records, unions and enums
  nanoc
    s Pair
      a,b: int
    u Number
      n: int
      x: double
    e Tag
      FIRST, SECOND
    f main() -> int
      Pair p={1,2}
      Number n={3}
      ptr: Pair * = &p
      return ptr->a+ptr->b!=n.n || SECOND!=1
reject require
  nanoc
    f missing -> int
      return 0
reject omit ':'
  nanoc
    f main() -> int
      if 1:
        return 0
reject for requires
  nanoc
    f main() -> int
      for i 0..3
        return i
