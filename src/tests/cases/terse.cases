suite bare return types, optional empty parentheses, punctuation-free function/control layout
case @f set(int *p) static void
  nanoc
    @f set(int *p) static void
      *p=42
    @f main int
      n:=0
      for ;;
        set(&n)
        break
      n!=42

case @f add(int a,b) int = a+b
  nanoc
    @f add(int a,b) int = a+b
    @f main int
      total:=0
      for i 0..10
        total+=i
      add(total,1)!=46

case @f sign(int n) int
  nanoc
    @f sign(int n) int
      if n>0
        1
      elif n<0
        -1
      else
        0
    @f main() int = sign(-3)!=-1 || sign(0)!=0 || sign(5)!=1

case @f sign(int n) int
  nanoc
    @f sign(int n) int
      if n>0
        1
      else if n<0
        -1
      else
        0
    @f main int = sign(-3)!=-1 || sign(0)!=0 || sign(5)!=1

case #include <stdio.h>
  nanoc
    #include <stdio.h>
    @f greet
      puts("ok")
    int main(void){greet();return 0;}
  prints
    ok

case @f add(int a,b) int =
  nanoc
    @f add(int a,b) int =
      (
        a+b
      )
    @f inc(int *p)
      (*p)++
    @f main int
      x:=2
      inc(&x)
      add(x,4)!=7

case @m zero
  nanoc
    @m zero
      0
    @m maxfn($name,$type)
      @f $name($type a,b) $type
        a>b?a:b
    @maxfn(big,int)
    @f main int = big(@zero,@zero())!=0

case @m square($x) =
  nanoc
    @m square($x) =
      quote(($x)*($x))
    @m id($x) = x
    @f main int = @id(@square(7))!=49

case @m answer = 42
  nanoc
    @m answer = 42
    @f main int = @answer!=42

case @m answer=42; @f value int=@answer; @f main int=
  nanoc
    @m answer=42; @f value int=@answer; @f main int=value()!=42;

case @f main int
  nanoc
    @f main int
      @ct
        f constant
          6*7
        n:=constant()
        emit(quote(int answer=$n;))
      answer!=42

case #include <vector>
  nanoc
    #include <vector>
    @f count(const std::vector<int>& xs) int = (int)xs.size()
    @f main int
      xs:=std::vector<int>(3,2)
      count(xs)!=3
  cpp

case @f count int
  nanoc
    @f count int
      int x=0
      => sizeof x
    @f main int = count()!=(int)sizeof(int)

case @f main int
  nanoc
    @f main int
      sum:=0
      for int i=0;i<4;i++
        sum+=i
      sum!=6

case #include <vector>
  nanoc
    #include <vector>
    @f main int
      xs:=std::vector<int>(3,2)
      sum:=0
      for x xs
        sum+=x
      sum!=6
  cpp

case #include <vector>
  nanoc
    #include <vector>
    @f main int
      bits:=std::vector<bool>(3)
      for bit bits
        bit=true
      !bits[0] || !bits[1] || !bits[2]
  cpp

case @m repeat($n,$body:block)
  nanoc
    @m repeat($n,$body:block)
      for(int $fresh(i)=0;$fresh(i)<$n;$fresh(i)++) $body
    @m scope($body:block)
      $body
    @m three=3
    @f main int
      count:=0
      @repeat(@three)
        @scope
          count++
      count!=3

case @s P x,y:i32
  nanoc
    @s P x,y:i32
    @s N
      v:i32
      nx:*N
    @e C a,b=4,c
    @u U i:i32; f:f32
    @f main int
      P p={1,2}
      N n={3,0}
      C k=c
      p.x+p.y+n.v!=6 || k!=5 || sizeof(U)!=4

case @use stdio
  nanoc
    @use stdio
    @c
      static int twice(int x) { return x*2; }
    @f main int
      say "v", twice(2), 1.5
      twice(1)!=2
  prints
    v 4 1.5

case @f add(i32 a,b) i32 = a+b
  nanoc
    @f add(i32 a,b) i32 = a+b
    @f main int
      u8 x=200
      f64 y=1.5
      cstr s="hi"
      add(x,2)!=202 || y!=1.5 || s[1]!='i'

reject indented function body
  nanoc
    @f main int
    0

reject unexpected indentation
  nanoc
    @f main int
      x:=0
        x

reject exhaustive
  nanoc
    @f main int
      if 1
        0

reject matching if
  nanoc
    @f main int
      else if 1
        0

reject spaces for indentation
  nanoc
    @f main int
    	0

case defer runs at block end and before return
  nanoc
    @use stdio
    @f open2(int fail) int
      puts("open")
      defer puts("close")
      if fail
        ret 7
      3
    @f main int
      defer puts("bye")
      printf("%d\n", open2(0))
      printf("%d\n", open2(1))
      0
  prints
    open
    close
    3
    open
    close
    7
    bye

case say adds stdio itself
  nanoc
    @f main int
      say "n", 5
      0
  prints
    n 5

case match chooses an arm like switch
  nanoc
    @f size(int x) int
      r:=0
      match x
        1, 2
          r=10
        3
          r=30
        else
          r=-1
      r
    @f main int = size(2)!=10 || size(3)!=30 || size(9)!=-1

case use takes lists, bundles and local headers
  nanoc
    @use std, math
    @f main int
      printf("%d %.0f\n", (int)strlen("ab"), floor(2.5))
      0
  prints
    2 2

case use drops the .h for C++ standard headers
  nanoc
    @use std, vector
    @f main int
      std::vector<int> v(3, 2)
      v.size()!=3
  cpp
