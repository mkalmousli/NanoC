// Text shown by --help.
@lang 1
+ "nanoc/nanoc.h"

// Prints the usage text.
f nc_help(FILE *out) -> void
  fputs(
          "NanoC " NC_VERSION " - compact C and C++ transpiler\n" "Usage: nanoc [options] input.nc\n"
          "  emit/check/expand/explain/inspect FILE [--json]\n"
          "  build/run FILE... [-o PATH] [--std c11] [--cflag ARG] [--json]\n"
          "  build FILE --emit-c     Emit C only; never invoke the C compiler\n"
          "  convert FILE --to nanoc [--conservative|--compact] [-o PATH]\n"
          "  fmt FILE [--write|--check] [--json]\n"
          "  tokens FILE [--encoding cl100k_base|o200k_base] [--json]\n"
          "  test FILE... --json     Build and run independent main functions\n"
          "  doctor --json          Report compiler availability\n"
          "  -o PATH             Output file (default stdout; '-' means stdout)\n"
          "  --lang c|c++        Output C11 or C++17 (default c)\n"
          "  --check             Validate expansion without writing code\n"
          "  --diagnostics json  Machine-readable errors/check reports\n"
          "  --describe [topic]  Small JSON card; topics: syntax, builtins, builtin name\n"
          "  --prototypes        Print prototypes of non-static functions\n"
          "  --map PATH          Export compiler-owned expansion map JSON\n"
          "  --trace-json        Emit generated C and expansion events as JSON\n"
          "  --std LEVEL         c89, c99, c11 or c17: restrict generated C features\n"
          "  --emit MODE         normal (readable C, default) or mini (smallest C)\n"
          "  --line-directives   Emit #line markers mapping C back to NanoC lines\n"
          "  --max-depth N       Expansion/evaluation nesting (default 128; safety cap 512)\n"
          "  --max-steps N       Execution budget (default 1000000; 0 unlimited)\n"
          "  --max-passes N      Pipeline budget (default 32; 0 unlimited)\n"
          "  --max-output N      Input/generated byte budget (default 16777216)\n"
          "  --help, --version   Show help/version\n" "\n" "Manage NanoC:\n"
          "  nanoc editor [list|install|remove] [NAME|--all]   Editor syntax (default: detected)\n"
          "  nanoc update                                      Update to the latest release\n"
          "  nanoc uninstall [--yes]                           Remove NanoC and editor integrations\n",
          out)
