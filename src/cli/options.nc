#include "nanoc/cli.h"
#include <errno.h>
@f positive(NcContext *c, const char *s) static size_t
  char *end
  errno = 0
  unsigned long long n = strtoull(s, &end, 10)
  if !*s || *s == '-' || *end || errno || !n || n > SIZE_MAX
    nc_fail(c, 0, "expected a positive integer: %s", s)
  (size_t)n
@f nc_options(NcContext *c, int argc, char **argv) NcOptions
  NcOptions o = {.input = "", .output = "-", .action = ""}
  bool positional = false
  for int i = 1; i < argc; ++i
    char *arg = argv[i]
    if !positional && !strcmp(arg, "--")
      positional = true
    else
      if !positional && !strcmp(arg, "--check")
        o.check = true
        c->effects = false
      else
        if !positional && !strcmp(arg, "--no-effects")
          c->effects = false
        else
          if !positional && (!strcmp(arg, "--help") || !strcmp(arg, "--version") || !strcmp(arg, "--describe"))
            o.action = arg
          else
            if !positional && (!strcmp(arg, "-o") || !strcmp(arg, "--lang") || !strcmp(arg, "--diagnostics") || !strcmp(arg, "--max-depth") || !strcmp(arg, "--max-steps") || !strcmp(arg, "--max-passes") || !strcmp(arg, "--max-output"))
              if ++i == argc
                nc_fail(c, 0, "missing value for %s", arg)
              char *value = argv[i]
              if !strcmp(arg, "-o")
                o.output = value
              else
                if !strcmp(arg, "--lang")
                  if strcmp(value, "c") && strcmp(value, "c++")
                    nc_fail(c, 0, "--lang requires c or c++")
                  c->cpp = !strcmp(value, "c++")
                else
                  if !strcmp(arg, "--diagnostics")
                    if strcmp(value, "json")
                      nc_fail(c, 0, "--diagnostics requires json")
                    o.json = true
                  else
                    if !strcmp(arg, "--max-depth")
                      c->max_depth = positive(c, value)
                    else
                      if !strcmp(arg, "--max-steps")
                        c->max_steps = !strcmp(value, "0") ? 0 : positive(c, value)
                      else
                        if !strcmp(arg, "--max-passes")
                          c->max_passes = !strcmp(value, "0") ? 0 : positive(c, value)
                        else
                          c->max_output = positive(c, value)
            else
              if !positional && *arg == '-'
                nc_fail(c, 0, "unknown option: %s", arg)
              else
                if *o.input
                  nc_fail(c, 0, "expected one input file")
                else
                  o.input = arg
                  c->file = arg
  if !*o.action && !*o.input
    nc_fail(c, 0, "missing input file; use --help")
  o
@f nc_help(FILE *out) void
  fputs("NanoC " NC_VERSION " — compact C and C++ transpiler\n" "Usage: nanoc [options] input.nc\n" "  -o PATH             Output file (default stdout; '-' means stdout)\n" "  --lang c|c++        Output C11 or C++17 (default c)\n" "  --check             Validate expansion without writing code\n" "  --diagnostics json  Machine-readable errors/check reports\n" "  --describe [topic]  Small JSON card; topics: syntax, asm, builtins, builtin name\n" "  --no-effects        Disable BT host writes/commands (implied by --check)\n" "  --max-depth N       Expansion/evaluation nesting (default 128; safety cap 512)\n" "  --max-steps N       Execution budget (default 1000000; 0 unlimited)\n" "  --max-passes N      Pipeline budget (default 32; 0 unlimited)\n" "  --max-output N      Input/generated byte budget (default 16777216)\n" "  --help, --version   Show help/version\n" "\nManage NanoC:\n" "  nanoc editor [list|install|remove] [NAME|--all]   Editor syntax (default: detected)\n" "  nanoc update                                      Update to the latest release\n" "  nanoc uninstall [--yes]                           Remove NanoC and editor integrations\n", out)
