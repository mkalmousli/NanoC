// Markdown DSL for generated docs: eval(read("src/dsl/md.tool.nc")) after gen.tool.nc.
// Blocks are strings; page(path, [blocks]) joins them with blank lines.
f h(n, t) = slice("######",0,n)+" "+t
f c(t) = "`"+t+"`"
f b(t) = "**"+t+"**"
f link(t, u) = "["+t+"]("+u+")"
f ul(xs)
  ls:=[]
  for x xs
    ls=push(ls,"- "+x)
  join(ls,"\n")
f code(lang, lines) = "```"+lang+"\n"+join(lines,"\n")+"\n```"
f row(cells) = "| "+join(cells," | ")+" |"
f tbl(head, rows)
  ls:=[row(head),row(map_dash(head))]
  for r rows
    ls=push(ls,row(r))
  join(ls,"\n")
f map_dash(head)
  d:=[]
  for x head
    d=push(d,"---")
  d
f page(path, blocks)
  out(path,"<!-- generated by src/docs.tool.nc; edit the NanoC source, not this file -->\n"+join(blocks,"\n\n")+"\n")
