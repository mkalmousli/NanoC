html
  Section [id=stats kicker="Measured on the compiler itself" title="Compact source.<br><em>Less to read.</em>"]
    p.~sub NanoC's own compiler is written in NanoC. Every source file is run through <code>nanoc</code>, and the C it generates is counted against the NanoC it came from.
    div.~stat-grid
      div.~stat <b class="~hi" data-stat="lines-saved">–</b><span>fewer lines than the C it generates</span>
      div.~stat <b data-stat="bytes-saved">–</b><span>fewer bytes of source</span>
      div.~stat <b data-stat="nc-lines">–</b><span>NanoC lines across <em data-stat="files">–</em> files</span>
      div.~stat <b data-stat="c-lines">–</b><span>lines of C it expands to</span>
    div.~compare
      div.~legend <span><i style="background:var(--lime)"></i>NanoC</span><span><i style="background:#3a3c33"></i>Generated C</span>
      div#~areas
      p.~method Method: non-blank lines and bytes, per area, summed over <code>src/**/*.nc</code>. Generated by <code>tools/site/site.nc</code> and updated on each regeneration (<span data-stat="generated">–</span>).
css
  .~stat-grid | display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:44px 0
  .~stat | background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:24px
  .~stat b | display:block;font:800 clamp(34px,4vw,50px)/1 var(--sans);letter-spacing:-.04em;color:var(--ink)
  .~stat b.~hi | color:var(--lime)
  .~stat span | display:block;margin-top:10px;color:var(--mute);font-size:14px
  div.~compare | background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:28px
  .~bar-row | display:grid;grid-template-columns:150px 1fr 110px;gap:14px;align-items:center;margin:14px 0;font-size:14px
  .~bar-row .~name | font-family:var(--mono);color:var(--mute)
  .~track | position:relative;height:22px;background:#1d1e18;border-radius:6px;overflow:hidden
  .~track i | position:absolute;inset:0 auto 0 0;border-radius:6px;background:#3a3c33;transition:width 1.2s cubic-bezier(.2,.7,.2,1)
  .~track i.~nc | background:linear-gradient(90deg,var(--lime),#a5d64a)
  .~bar-row .~num | font-family:var(--mono);text-align:right;color:var(--mute)
  .~legend | display:flex;gap:18px;font-size:13px;color:var(--mute);margin-bottom:6px;flex-wrap:wrap
  .~legend i | display:inline-block;width:12px;height:12px;border-radius:3px;margin-right:6px;vertical-align:-1px
  .~method | color:var(--dim);font-size:13px;margin-top:18px
  .~bars | display:grid;gap:14px;margin:0
  @media(max-width:1000px)
    .~stat-grid | grid-template-columns:1fr 1fr
  @media(max-width:700px)
    .~bar-row | grid-template-columns:90px 1fr 84px;gap:10px;font-size:12px
    .~bar-row | grid-template-columns:90px 1fr 70px
  @media(max-width:420px)
    .~stat-grid | grid-template-columns:1fr
js
  // ---- compiler stats, from docs/stats.json (regenerate: sh tools/site/stats.sh) ----
  const signed = (a, b) => { const p = pct(a, b); return (p >= 0 ? '−' : '+') + Math.abs(p) + '%'; }
  const fmt = n => n.toLocaleString('en-US')
  fetch('stats.json').then(r => r.json()).then(s =>
    const set = (k, v) => document.querySelectorAll(`[data-stat="${k}"]`).forEach(el => (el.textContent = v))
    set('lines-saved', signed(s.nc.lines, s.c.lines))
    set('bytes-saved', signed(s.nc.bytes, s.c.bytes))
    set('nc-lines', fmt(s.nc.lines))
    set('c-lines', fmt(s.c.lines))
    set('files', s.files)
    set('generated', s.generated)
    set('badge', signed(s.nc.lines, s.c.lines) + ' lines vs C')
    const max = Math.max(...s.areas.map(a => a.c))
    $('#~areas').replaceChildren(...s.areas.sort((a, b) => b.c - a.c).map(a =>
      const row = document.createElement('div')
      row.className = '~bar-row'
      row.innerHTML = `<span class="~name"></span><div class="~track"><i class="~c"></i><i class="~nc"></i></div><span class="~num"></span>`
      row.querySelector('.~name').textContent = a.name
      row.querySelector('.~num').textContent = fmt(a.nc) + ' / ' + fmt(a.c)
      const [c, nc] = row.querySelectorAll('i')
      c.style.width = (a.c / max * 100) + '%'
      nc.style.width = (a.nc / max * 100) + '%'
      return row
    ))
  ).catch(() =>
    $('#~areas').textContent = 'Stats unavailable. Run sh tools/site/stats.sh.'
  )
