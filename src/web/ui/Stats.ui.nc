Section [id=stats kicker="Measured on the compiler itself" title="Compact source.<br><em>Less to read.</em>"]
  Sub NanoC's own compiler is written in NanoC. Every source file is run through <code>nanoc</code>, and the C it generates is counted against the NanoC it came from.
  div
    css
      display:grid
      grid-template-columns:repeat(4,1fr)
      gap:14px
      margin:44px 0
      @media(max-width:1000px)
        grid-template-columns:1fr 1fr
      @media(max-width:420px)
        grid-template-columns:1fr
    Stat [key=bytes-saved] fewer characters than the C it generates
      css
        & b:first-child | color:var(--lime)
    Stat [key=lines-saved] fewer lines (non-blank)
    Stat [key=nc-lines] NanoC characters across <em data-stat="files">–</em> files
    Stat [key=c-lines] characters of C it expands to
  div
    css | background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:28px
    div
      css
        display:flex
        gap:18px
        font-size:13px
        color:var(--mute)
        margin-bottom:6px
        flex-wrap:wrap
        & i | display:inline-block;width:12px;height:12px;border-radius:3px;margin-right:6px;vertical-align:-1px
      span <i style="background:var(--lime)"></i>NanoC
      span <i style="background:#3a3c33"></i>Generated C
    Bars [as=areas]
    Fine Method: total characters (bytes), per area, summed over <code>src/**/*.nc</code>. Generated by <code>src/site/site.bt.nc</code> and updated on each regeneration (<span data-stat="generated">–</span>).
  js
    const fmt = n => n.toLocaleString('en-US')
    const set = (k, v) => document.querySelectorAll(`[data-stat="${k}"]`).forEach(x => (x.textContent = v))
    fetch('stats.json').then(r => r.json()).then(s =>
      set('lines-saved', signed(s.nc.lines, s.c.lines))
      set('bytes-saved', signed(s.nc.bytes, s.c.bytes))
      set('nc-lines', fmt(s.nc.bytes))
      set('c-lines', fmt(s.c.bytes))
      set('files', s.files)
      set('generated', s.generated)
      set('badge', signed(s.nc.bytes, s.c.bytes) + ' characters vs C')
      const max = Math.max(...s.areas.map(a => a.c))
      A.areas.replaceChildren(...s.areas.sort((a, b) => b.c - a.c).map(a =>
        const row = document.createElement('div')
        row.className = 'bar-row'
        row.innerHTML = `<span></span><div class="tr"><i class="c"></i><i></i></div><b></b>`
        row.firstChild.textContent = a.name
        row.lastChild.textContent = fmt(a.nc) + ' / ' + fmt(a.c)
        const [c, nc] = row.querySelectorAll('i')
        c.style.width = (a.c / max * 100) + '%'
        nc.style.width = (a.nc / max * 100) + '%'
        return row
      ))
    ).catch(() => A.areas.textContent = 'Stats unavailable. Run ./builder docs.')
