div
  css
    background:var(--panel)
    border:1px solid var(--line)
    border-radius:var(--r)
    padding:24px
    & b | display:block;font:800 clamp(34px,4vw,50px)/1 var(--sans);letter-spacing:-.04em;color:var(--ink)
    & span | display:block;margin-top:10px;color:var(--mute);font-size:14px
  b [data-stat=$key] –
  span $text
