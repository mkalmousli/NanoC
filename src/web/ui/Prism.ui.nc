html
  script [src=https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-core.min.js defer]
  script [src=https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-clike.min.js defer]
  script [src=https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-c.min.js defer]
  script [src=https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-bash.min.js defer]
css
  .token.comment | color:#777b73
  .token.keyword,.token.control | color:var(--violet)
  .token.function | color:var(--amber)
  .token.string | color:#b9d987
  .token.number,.token.boolean | color:var(--rose)
  .token.operator | color:#c2bcf4
  .token.class-name | color:var(--mint)
